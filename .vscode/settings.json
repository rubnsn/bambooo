{
    // NeoForge 1.21.1 開発用。コンパイルは Java 21 (Gradle toolchain が自動調達) のため言語サーバーにも JDK 21 を登録する。
    // Gradle デーモン自体は JDK 17 起動で問題ないため gradle.javaHome は 17 のまま。
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-21",
            "path": "C:\\Users\\white\\.gradle\\jdks\\eclipse_adoptium-21-amd64-windows.2",
            "default": true
        },
        {
            "name": "JavaSE-17",
            "path": "C:\\Program Files\\Eclipse Adoptium\\jdk-17.0.20.8-hotspot"
        }
    ],
    // Gradle デーモン/同期も JDK 17 で実行する
    "java.import.gradle.java.home": "C:\\Program Files\\Eclipse Adoptium\\jdk-17.0.20.8-hotspot",
    "gradle.javaHome": "C:\\Program Files\\Eclipse Adoptium\\jdk-17.0.20.8-hotspot",
    // build.gradle 変更時に自動で再同期する
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.import.gradle.enabled": true,
    "gradle.autoDetect": "on",
    "gradle.nestedProjects": false,
    // Minecraft の巨大ソースでは null 解析が重いので無効化
    "java.compile.nullAnalysis.nonnull": [],
    "java.compile.nullAnalysis.nullable": [],
    "java.compile.nullAnalysis.mode": "disabled",
    // 生成物をエクスプローラーから隠す
    "files.exclude": {
        "**/.gradle": true,
        "**/build/tmp": true,
        "**/build/classes": true,
        "**/build/_*": true
    }
}
